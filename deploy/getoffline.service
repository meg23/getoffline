[Unit]
Description=GetOffline media downloader and web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jellyfin
Group=jellyfin
WorkingDirectory=/opt/getoffline
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash -o pipefail -c 'PYTHONPATH="$PWD/src" .venv/bin/python -m main serve --host 0.0.0.0 --port 8080 2>&1 | tee app.log'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
